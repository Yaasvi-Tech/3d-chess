{
  "name": "chess3d",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Chess3D — a stylized 3D chess experience with themes, locations, board/piece styles and tournaments.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@react-three/postprocessing": "3.1.1",
    "chess.js": "1.4.0",
    "postprocessing": "6.37.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "three": "0.180.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "5.9.3",
    "vite": "^7.1.12",
    "vitest": "3.2.4"
  }
}
